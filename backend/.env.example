# Copy to backend/.env for local development. On Vercel, set the same variables in the
# project settings. Never commit the real .env.

# --- Server ---
# The frontend's development default talks to http://localhost:3000.
PORT=3000
# "production" enables strict CORS (FRONTEND_URL only) and hides server error details.
NODE_ENV=development
# Allowed CORS origin in production, and the base URL of password reset links.
FRONTEND_URL=http://localhost:5173

# --- Database and auth ---
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/nutriflow?retryWrites=true&w=majority
JWT_SECRET=a-long-random-string

# --- Email: password reset and the contact form (a Gmail address with an app password) ---
EMAIL_USERNAME=you@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# --- Food and exercise search ---
# https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=your-usda-key
# https://api-ninjas.com/
NINJA_API_KEY=your-api-ninjas-key

# --- AI coach ---
# With a local OLLAMA_URL it tries Ollama first and falls back to Groq; on Vercel it uses Groq.
# https://console.groq.com/
GROQ_API_KEY=your-groq-key
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
# Optional: AI_PROVIDER=groq or ollama forces one provider.
# Optional: GROQ_TIMEOUT_MS and OLLAMA_TIMEOUT_MS override the 20 s and 45 s request timeouts.
